<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ekranGlowny"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/przyciskAutor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/przycisk_autor"
        app:layout_constraintBottom_toTopOf="@id/przyciskStronaWww"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/przyciskStronaWww"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/przycisk_strona_www"
        app:layout_constraintBottom_toTopOf="@id/przyciskPolozenie"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/przyciskAutor" />

    <Button
        android:id="@+id/przyciskPolozenie"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/przycisk_polozenie"
        app:layout_constraintBottom_toTopOf="@id/poleAdresuWww"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/przyciskStronaWww" />

    <EditText
        android:id="@+id/poleAdresuWww"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/podpowiedz_adres_www"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:minHeight="48dp"
        android:text="@string/adres_poczatkowy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/przyciskPolozenie" />

</androidx.constraintlayout.widget.ConstraintLayout>
